    "pg": "^8.16.3",
    "podverse-external-services": "^5.1.12",
    "podverse-helpers": "^5.1.12",
    "podverse-mq": "^5.1.12",
    "podverse-orm": "^5.1.12",
    "podverse-parser": "^5.1.12",
    "typeorm": "^0.3.26",
