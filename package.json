{
  "name": "podverse-workers",
  "version": "5.0.1",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "dev:watch": "nodemon --watch 'src' --watch $(realpath node_modules/podverse-helpers) --watch $(realpath node_modules/podverse-queue) --delay 500ms -x \"npm run build\"",
    "build": "tsc",
    "queueDeleteAll": "ts-node ./src/index.ts queueDeleteAll",
    "queueRSSAddAll": "ts-node ./src/index.ts queueRSSAddAll",
    "queueRSSRunParser": "ts-node ./src/index.ts queueRSSRunParser",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "start": "ts-node ./dist/index.js",
    "prepare": "npm run build"
  },
  "author": "",
  "license": "AGPLv3",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.6.4",
    "amqplib": "^0.10.4",
    "axios": "^1.7.7",
    "module-alias": "^2.2.3",
    "pg": "^8.12.0",
    "podcast-partytime": "^4.8.1",
    "podverse-helpers": "^5.0.0",
    "podverse-queue": "^5.0.0",
    "shortid": "^2.2.16",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.18.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.8.0",
    "@types/node": "^22.1.0",
    "eslint": "^9.9.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1"
  }
}
